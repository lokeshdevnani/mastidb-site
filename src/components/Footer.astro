---
---

<footer class="border-t border-[var(--line)] bg-[var(--surface)] pt-16 pb-12">
  <div class="site-container">
    
    <!-- Closing CTA Banner matching mock.png -->
    <div class="p-6 sm:p-10 lg:p-12 rounded-3xl bg-[var(--surface-tint)] border border-[var(--line)] mb-14 relative overflow-hidden shadow-sm">
      <!-- Subtle ambient gradient background glow -->
      <div class="absolute -right-20 -bottom-20 w-72 h-72 rounded-full bg-[var(--brand)]/5 pointer-events-none blur-3xl"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        <!-- Left: Mascot with Speech Bubble (lg:col-span-3) -->
        <div class="lg:col-span-3 flex flex-col items-center justify-center relative">
          <!-- Speech bubble from mock.png -->
          <div class="bg-white border border-[var(--line)] px-3 py-1 rounded-full text-[11px] font-bold text-[var(--brand)] shadow-xs mb-2 whitespace-nowrap">
            <span>Open source & more Masti for data!</span>
          </div>

          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-[var(--lavender)] border border-[var(--brand)]/20 p-2 flex items-center justify-center shadow-xs">
            <img
              src="/mastidb-logo.png"
              alt="MastiDB mascot smiling"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Center: Headline, Narrative & Action Buttons (lg:col-span-6) -->
        <div class="lg:col-span-6 flex flex-col items-center lg:items-start text-center lg:text-left">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-[var(--ink)] tracking-tight mb-2">
            Try MastiDB today
          </h3>
          <p class="text-sm sm:text-base text-[var(--muted)] leading-relaxed mb-6">
            Install, explore the code, run some queries, and have fun!
          </p>

          <!-- Action buttons row matching mock.png -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3">
            <!-- Copy pip install button -->
            <button
              id="footer-copy-pip"
              type="button"
              class="inline-flex items-center gap-2 px-4.5 py-2.5 rounded-xl bg-[var(--ink)] hover:bg-[var(--brand)] text-white text-xs font-mono font-medium transition-all shadow-md focus-visible:ring-2 focus-visible:ring-[var(--brand)] cursor-pointer"
              title="Copy pip install mastidb"
            >
              <span class="text-[var(--brand-blue)] select-none">&gt;_</span>
              <span>pip install mastidb</span>
              <svg id="footer-copy-icon" class="w-3.5 h-3.5 text-slate-300 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <svg id="footer-check-icon" class="w-3.5 h-3.5 text-emerald-400 ml-0.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>

            <!-- View on GitHub button -->
            <a
              href="https://github.com/lokeshdevnani/mastidb"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[var(--line)] bg-[var(--surface)] hover:bg-[var(--surface-tint)] text-xs font-semibold text-[var(--ink)] transition-all hover:border-[var(--brand)]/30 focus-visible:ring-2 focus-visible:ring-[var(--brand)] shadow-xs"
            >
              <svg class="w-3.5 h-3.5 fill-current text-[var(--ink)]" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>View on GitHub</span>
            </a>

            <!-- Divider -->
            <span class="hidden sm:inline-block text-[var(--line-strong)] select-none">|</span>

            <!-- Buy me a coffee link -->
            <a
              href="https://buymeacoffee.com/lokeshdevnani"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-[var(--muted)] hover:text-[var(--brand)] transition-colors focus-visible:ring-2 focus-visible:ring-[var(--brand)]"
              title="Support the creator on Buy Me a Coffee"
            >
              <span class="text-amber-500">☕</span>
              <span>Buy me a coffee</span>
            </a>
          </div>
        </div>

        <!-- Right: Handwritten Playful Note from mock.png (lg:col-span-3) -->
        <div class="lg:col-span-3 flex flex-col items-center lg:items-end justify-center">
          <div class="p-3 rounded-2xl bg-white/80 border border-[var(--line)] shadow-xs flex items-center gap-2 transform rotate-2 hover:rotate-0 transition-transform">
            <div class="text-xs font-semibold text-[var(--brand)] flex items-center gap-1.5">
              <span>Ideas, issues, PRs welcome!</span>
              <span class="text-base select-none">🎉</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Footer Navigation & Attributions matching mock.png -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-6 border-t border-[var(--line)] text-xs text-[var(--muted)]">
      <!-- Left Wordmark -->
      <div class="flex items-center gap-2.5">
        <img src="/mastidb-logo.png" alt="MastiDB" class="w-5 h-5 object-contain" />
        <span class="font-extrabold text-base tracking-tight text-[var(--ink)]">MastiDB</span>
      </div>

      <!-- Center Links -->
      <div class="flex items-center gap-6 font-medium">
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/ARCHITECTURE.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Docs
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/ROADMAP.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Roadmap
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Contributing
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          GitHub
        </a>
      </div>

      <!-- Right Attribution matching mock -->
      <div class="text-xs text-[var(--muted)]">
        Made with ☕ and curiosity.
      </div>
    </div>

  </div>
</footer>

<script>
  const footerCopyBtn = document.getElementById('footer-copy-pip');
  const footerCopyIcon = document.getElementById('footer-copy-icon');
  const footerCheckIcon = document.getElementById('footer-check-icon');

  footerCopyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('pip install mastidb');
      if (footerCopyIcon && footerCheckIcon) {
        footerCopyIcon.classList.add('hidden');
        footerCheckIcon.classList.remove('hidden');
        setTimeout(() => {
          footerCopyIcon.classList.remove('hidden');
          footerCheckIcon.classList.add('hidden');
        }, 2000);
      }
    } catch (e) {
      console.error('Failed to copy', e);
    }
  });
</script>
