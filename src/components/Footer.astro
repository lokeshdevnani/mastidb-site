---
---

<footer class="border-t border-[var(--line)] bg-[var(--surface)] pt-16 pb-12">
  <div class="site-container">
    
    <!-- Closing CTA Banner matching mock.png -->
    <div class="p-8 sm:p-12 lg:p-14 rounded-3xl bg-[var(--surface-tint)] border border-[var(--line)] mb-14 relative overflow-hidden shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        <!-- Left: Welcoming Mascot with Callout Note (lg:col-span-3) -->
        <div class="lg:col-span-3 flex flex-col items-center justify-center relative">
          <!-- Playful note from mock.png -->
          <div class="bg-white border border-[var(--line)] px-3.5 py-1 rounded-full text-xs font-bold text-[var(--brand)] shadow-xs mb-3 whitespace-nowrap">
            <span>Open source & more Masti for data!</span>
          </div>

          <div class="w-28 h-28 sm:w-32 sm:h-32 flex items-center justify-center">
            <img
              src="/mascot-welcoming.png"
              alt="MastiDB Welcoming Mascot"
              class="w-full h-full object-contain drop-shadow-sm hover:scale-105 transition-transform"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Center: Headline, Narrative & Action Buttons (lg:col-span-7) -->
        <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
          <h3 class="text-3xl sm:text-4xl font-extrabold text-[var(--ink)] tracking-tight mb-2">
            Try MastiDB today
          </h3>
          <p class="text-sm sm:text-base text-[var(--muted)] leading-relaxed mb-6">
            Install, explore the code, run some queries, and have fun!
          </p>

          <!-- Action buttons row matching mock.png -->
          <div class="flex flex-wrap sm:flex-nowrap items-center justify-center lg:justify-start gap-2.5 sm:gap-3">
            <!-- Copy pip install button -->
            <button
              id="footer-copy-pip"
              type="button"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--ink)] hover:bg-[var(--brand)] text-white text-xs font-mono font-medium transition-all shadow-md focus-visible:ring-2 focus-visible:ring-[var(--brand)] cursor-pointer whitespace-nowrap"
              title="Copy pip install mastidb"
            >
              <span class="text-[var(--brand-blue)] select-none">&gt;_</span>
              <span>pip install mastidb</span>
              <svg id="footer-copy-icon" class="w-3.5 h-3.5 text-slate-300 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <svg id="footer-check-icon" class="w-3.5 h-3.5 text-emerald-400 ml-0.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>

            <!-- View on GitHub button -->
            <a
              href="https://github.com/lokeshdevnani/mastidb"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl border border-[var(--line)] bg-white hover:bg-[var(--surface-tint)] text-xs font-bold text-[var(--ink)] transition-all hover:border-[var(--brand)]/30 focus-visible:ring-2 focus-visible:ring-[var(--brand)] shadow-xs whitespace-nowrap"
            >
              <svg class="w-3.5 h-3.5 fill-current text-[var(--ink)]" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>View on GitHub</span>
            </a>

            <!-- Divider -->
            <span class="hidden sm:inline-block text-[var(--line-strong)] select-none">|</span>

            <!-- Official Yellow Buy Me A Coffee Button per user request -->
            <a
              href="https://buymeacoffee.com/lokeshdevnani"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-[#FFDD00] hover:bg-[#FFEA00] text-black text-xs font-bold transition-all shadow-sm hover:shadow hover:-translate-y-0.5 active:translate-y-0 border border-amber-300/60 whitespace-nowrap"
              title="Support the creator on Buy Me a Coffee"
            >
              <svg class="w-4 h-4 fill-black" viewBox="0 0 24 24">
                <path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-.775-1.63-.388-.466-.889-.817-1.45-1.018-.56-.201-1.162-.258-1.745-.164-.582.093-1.13.336-1.587.702l-.527.425C13.25 3.398 11.666 3 10 3 6.134 3 3 6.134 3 10c0 2.923 1.777 5.438 4.316 6.517l.82 3.69c.123.553.435 1.042.88 1.382.446.339.992.518 1.545.503h2.878c.553.015 1.099-.164 1.545-.503.445-.34.757-.829.88-1.382l.82-3.69C19.223 15.438 21 12.923 21 10c0-1.248-.33-2.42-.904-3.435l.12-.15zm-2.072 5.027c-.31.874-.82 1.656-1.488 2.28-.21.196-.44.372-.686.526l-.68 3.064c-.033.148-.117.279-.236.37-.12.091-.266.139-.414.135h-2.88c-.148.004-.294-.044-.414-.135-.119-.091-.203-.222-.236-.37l-.68-3.064c-.246-.154-.476-.33-.686-.526-.668-.624-1.178-1.406-1.488-2.28C8.243 11.08 8 10.552 8 10c0-1.103.897-2 2-2h4c1.103 0 2 .897 2 2 0 .552-.243 1.08-.456 1.442z"/>
              </svg>
              <span>Buy me a coffee</span>
            </a>
          </div>
        </div>

        <!-- Right: Handwritten Playful Note from mock.png (lg:col-span-2) -->
        <div class="lg:col-span-2 flex flex-col items-center lg:items-end justify-center">
          <div class="p-3.5 rounded-2xl bg-white border border-[var(--line)] shadow-xs flex items-center gap-2 transform rotate-2 hover:rotate-0 transition-transform">
            <div class="text-xs font-bold text-[var(--brand)] flex items-center gap-1.5">
              <span>Ideas, issues, PRs welcome!</span>
              <span class="text-base select-none">🎉</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Footer Navigation & Attributions matching mock.png -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-6 border-t border-[var(--line)] text-xs text-[var(--muted)]">
      <!-- Left Wordmark with Masti + purple DB -->
      <div class="flex items-center gap-2.5">
        <div class="w-6 h-6 rounded-lg bg-[var(--lavender)] border border-[var(--brand)]/20 flex items-center justify-center p-0.5 overflow-hidden shadow-xs">
          <img src="/mastidb-logo.png" alt="MastiDB Logo" class="w-full h-full object-contain" />
        </div>
        <div class="flex items-baseline">
          <span class="font-extrabold text-lg tracking-tight text-[var(--ink)]">Masti</span><span class="font-extrabold text-lg tracking-tight text-[var(--brand)]">DB</span>
        </div>
      </div>

      <!-- Center Links -->
      <div class="flex items-center gap-6 font-semibold">
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/ARCHITECTURE.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Docs
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/ROADMAP.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Roadmap
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Contributing
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          GitHub
        </a>
      </div>

      <!-- Right Attribution matching mock -->
      <div class="text-xs text-[var(--muted)] font-medium">
        Made with ☕ and curiosity.
      </div>
    </div>

  </div>
</footer>

<script>
  const footerCopyBtn = document.getElementById('footer-copy-pip');
  const footerCopyIcon = document.getElementById('footer-copy-icon');
  const footerCheckIcon = document.getElementById('footer-check-icon');

  footerCopyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('pip install mastidb');
      if (footerCopyIcon && footerCheckIcon) {
        footerCopyIcon.classList.add('hidden');
        footerCheckIcon.classList.remove('hidden');
        setTimeout(() => {
          footerCopyIcon.classList.remove('hidden');
          footerCheckIcon.classList.add('hidden');
        }, 2000);
      }
    } catch (e) {
      console.error('Failed to copy', e);
    }
  });
</script>
