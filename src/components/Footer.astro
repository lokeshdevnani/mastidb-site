---
---

<footer class="border-t border-[var(--line)] bg-[var(--surface)] pt-16 pb-12">
  <div class="site-container">
    
    <!-- Closing CTA Banner -->
    <div class="p-8 sm:p-12 rounded-3xl bg-[var(--surface-tint)] border border-[var(--line)] mb-14 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left relative overflow-hidden">
      <!-- Subtle accent background highlight -->
      <div class="absolute -right-20 -bottom-20 w-64 h-64 rounded-full bg-[var(--brand)]/5 pointer-events-none blur-3xl"></div>

      <div class="max-w-xl relative z-10">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-[var(--ink)] tracking-tight mb-3">
          Inspect the code. Tweak the engine.
        </h3>
        <p class="text-sm sm:text-base text-[var(--muted)] leading-relaxed">
          MastiDB is completely open source under the MIT license. Fork the repository, explore the file layouts on disk, and benchmark your own queries.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 relative z-10 w-full sm:w-auto">
        <!-- Primary Action: Explore GitHub -->
        <a
          href="https://github.com/lokeshdevnani/mastidb"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--ink)] hover:bg-[var(--brand)] text-white text-sm font-semibold transition-all shadow-md hover:shadow-lg focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--brand)]"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>Explore GitHub Repo</span>
        </a>

        <!-- Quiet Secondary: Buy me a coffee -->
        <a
          href="https://buymeacoffee.com/lokeshdevnani"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl border border-[var(--line)] bg-[var(--surface)] hover:bg-[var(--lavender)] text-xs font-semibold text-[var(--muted)] hover:text-[var(--brand)] transition-all hover:border-[var(--brand)]/30"
          title="Support the creator on Buy Me a Coffee"
        >
          <span class="text-amber-500">☕</span>
          <span>Buy me a coffee</span>
        </a>
      </div>
    </div>

    <!-- Bottom Footer Navigation & Attributions -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-6 border-t border-[var(--line)] text-xs text-[var(--muted)]">
      <div class="flex items-center gap-3">
        <img src="/mastidb-logo.png" alt="MastiDB" class="w-5 h-5 object-contain" />
        <span class="font-bold text-[var(--ink)]">MastiDB</span>
        <span>•</span>
        <span>MIT License</span>
        <span>•</span>
        <span>Single-Node Columnar OLAP in Python</span>
      </div>

      <div class="flex items-center gap-6 font-medium">
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/ARCHITECTURE.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Architecture
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/ROADMAP.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Roadmap
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          Contributing
        </a>
        <a href="https://github.com/lokeshdevnani/mastidb" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
          GitHub
        </a>
      </div>
    </div>

    <div class="text-center mt-6 text-[11px] text-[var(--muted)]">
      Crafted with mechanical sympathy by <a href="https://github.com/lokeshdevnani" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--brand)] underline underline-offset-2">Lokesh Devnani</a>.
    </div>

  </div>
</footer>
