---
import { HeroTerminal } from './HeroTerminal';
---

<section class="relative pt-6 pb-16 md:pt-12 md:pb-24 overflow-hidden border-b border-[var(--line)] bg-[var(--surface)]">
  <!-- Subtle background ambient grid -->
  <div class="absolute inset-0 bg-[radial-gradient(var(--line)_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

  <div class="site-container relative z-10">
    <!-- Top badge: Clear statement of experimental status matching kicker -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--lavender)] border border-[var(--brand)]/20 text-xs font-semibold text-[var(--brand)] mb-6 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[var(--brand)] animate-pulse"></span>
      <span class="tracking-wide">OPEN SOURCE ANALYTICS • EXPERIMENTAL OLAP ENGINE</span>
    </div>

    <!-- Hero Composition Grid (Desktop: Left Copy, Center Mascot, Right Terminal) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">
      
      <!-- Left Column: Headline, Narrative, CTAs & Feature Pills (lg:col-span-5) -->
      <div class="lg:col-span-5 flex flex-col justify-center">
        <h1 class="hero-headline font-extrabold tracking-tight text-[var(--ink)] leading-[1.05] mb-5">
          A serious OLAP <br class="hidden sm:inline" />
          database engine. <br />
          <span class="text-[var(--brand)]">Written in Python.</span>
        </h1>

        <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed mb-6 prose-measure">
          Explore how a columnar database engine stores data on disk, cuts row scans with Roaring Bitmaps, and answers analytical queries with mechanical sympathy.
        </p>

        <!-- Primary & Secondary CTAs -->
        <div class="flex flex-wrap items-center gap-3.5 mb-7">
          <!-- Copy pip install button -->
          <button
            id="hero-copy-pip"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--ink)] hover:bg-[var(--brand)] text-white text-xs font-mono font-medium transition-all shadow-md hover:shadow-lg focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--brand)] cursor-pointer"
            title="Copy install command"
          >
            <span class="text-[var(--brand-blue)] select-none">&gt;_</span>
            <span>pip install mastidb</span>
            <svg id="hero-copy-icon" class="w-3.5 h-3.5 text-slate-300 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <svg id="hero-check-icon" class="w-3.5 h-3.5 text-emerald-400 ml-1 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </button>

          <!-- View on GitHub button -->
          <a
            href="https://github.com/lokeshdevnani/mastidb"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4.5 py-3 rounded-xl border border-[var(--line)] bg-[var(--surface)] hover:bg-[var(--surface-tint)] text-[var(--ink)] text-xs font-semibold transition-all hover:border-[var(--brand)]/30 focus-visible:ring-2 focus-visible:ring-[var(--brand)] shadow-sm"
          >
            <svg class="w-4 h-4 fill-current text-[var(--ink)]" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>View on GitHub</span>
          </a>
        </div>

        <!-- 4 Feature Pills from mock.png -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-[var(--line)]">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--surface-tint)] border border-[var(--line)] text-[11px] font-medium text-[var(--muted)]">
            <svg class="w-3.5 h-3.5 text-[var(--brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 4v16M15 4v16" />
            </svg>
            <span>Columnar storage</span>
          </div>

          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--surface-tint)] border border-[var(--line)] text-[11px] font-medium text-[var(--muted)]">
            <svg class="w-3.5 h-3.5 text-[var(--bitmap-amber)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            <span>Bitmap indexes</span>
          </div>

          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--surface-tint)] border border-[var(--line)] text-[11px] font-medium text-[var(--muted)]">
            <svg class="w-3.5 h-3.5 text-[var(--result-green)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Fast aggregations</span>
          </div>

          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--surface-tint)] border border-[var(--line)] text-[11px] font-medium text-[var(--muted)]">
            <svg class="w-3.5 h-3.5 text-[var(--brand-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span>Pure Python</span>
          </div>
        </div>

      </div>

      <!-- Center Column: Animated Mascot (lg:col-span-3) -->
      <div class="lg:col-span-3 flex flex-col items-center justify-center relative py-2">
        <div class="mascot-wrapper flex flex-col items-center justify-center relative">
          <!-- Speech Bubble from mock.png -->
          <div class="mascot-bubble absolute -top-4 bg-white border border-[var(--line)] px-3 py-1 rounded-full text-xs font-bold text-[var(--brand)] shadow-sm pointer-events-none z-10 flex items-center gap-1 whitespace-nowrap">
            <span>Same data. More Masti!</span>
            <span class="text-amber-500">✨</span>
          </div>

          <!-- Preserves entire mascot body including legs at all viewport sizes without clipping -->
          <img
            src="/mastidb-mascot.webp"
            alt="MastiDB Mascot thinking, winking and pointing to the terminal"
            width="360"
            height="340"
            class="mascot-image max-w-[190px] sm:max-w-[220px] md:max-w-[240px] lg:max-w-[260px] h-auto object-contain select-none mt-2"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- Right Column: Interactive Terminal + 4-Step Pipeline Box (lg:col-span-4) -->
      <div class="lg:col-span-4 flex flex-col gap-4 w-full">
        <!-- Interactive Terminal -->
        <HeroTerminal client:load />

        <!-- 4-Step Pipeline directly beneath Terminal per mock.png -->
        <div class="p-3.5 rounded-xl border border-[var(--line)] bg-[var(--surface-tint)] shadow-sm">
          <div class="grid grid-cols-4 gap-1.5 text-center text-xs mb-2">
            <div class="p-1.5 rounded-lg bg-[var(--surface)] border border-[var(--line)] flex flex-col items-center shadow-xs">
              <span class="text-[11px] font-bold text-[var(--brand)]">SQL</span>
              <span class="text-[9px] text-[var(--muted)] leading-tight">Query</span>
            </div>
            <div class="p-1.5 rounded-lg bg-[var(--dict-violet-bg)] border border-[var(--dict-violet-border)] flex flex-col items-center shadow-xs">
              <span class="text-[11px] font-bold text-[var(--dict-violet)]">Dict</span>
              <span class="text-[9px] text-[var(--dict-violet)]/80 leading-tight">Lookup</span>
            </div>
            <div class="p-1.5 rounded-lg bg-[var(--bitmap-amber-bg)] border border-[var(--bitmap-amber-border)] flex flex-col items-center shadow-xs">
              <span class="text-[11px] font-bold text-[var(--bitmap-amber)]">Bitmap</span>
              <span class="text-[9px] text-[var(--bitmap-amber)]/80 leading-tight">Index</span>
            </div>
            <div class="p-1.5 rounded-lg bg-[var(--result-green-bg)] border border-[var(--result-green-border)] flex flex-col items-center shadow-xs">
              <span class="text-[11px] font-bold text-[var(--result-green)]">Aggregate</span>
              <span class="text-[9px] text-[var(--result-green)]/80 leading-tight">Result</span>
            </div>
          </div>
          <div class="text-[10px] text-center text-[var(--muted)] font-mono">
            From a simple SQL query to fast analytical results.
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-pip');
  const copyIcon = document.getElementById('hero-copy-icon');
  const checkIcon = document.getElementById('hero-check-icon');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('pip install mastidb');
      if (copyIcon && checkIcon) {
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      }
    } catch (e) {
      console.error('Failed to copy', e);
    }
  });
</script>

<style>
  .hero-headline {
    font-size: clamp(2.3rem, 4.5vw, 3.8rem);
  }

  @media (min-width: 1024px) {
    .hero-headline {
      font-size: clamp(2.6rem, 3.8vw, 3.75rem);
    }
  }

  /* Mascot styles: ensure whole figure is preserved without clipping or zoom */
  .mascot-image {
    aspect-ratio: 360 / 340;
    filter: drop-shadow(0 12px 24px rgba(20, 32, 58, 0.08));
    transition: transform 0.2s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot-image {
      animation: none !important;
    }
  }
</style>
