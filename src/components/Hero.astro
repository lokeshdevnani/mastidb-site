---
import { HeroTerminal } from './HeroTerminal';
---

<section class="relative pt-6 pb-16 md:pt-14 md:pb-24 overflow-hidden border-b border-[var(--line)] bg-[var(--surface)]">
  <!-- Subtle background ambient grid -->
  <div class="absolute inset-0 bg-[radial-gradient(var(--line)_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

  <div class="site-container relative z-10">
    <!-- Top badge: Clear statement of experimental status -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--lavender)] border border-[var(--brand)]/20 text-xs font-semibold text-[var(--brand)] mb-6 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[var(--brand)] animate-pulse"></span>
      <span>EXPERIMENTAL OLAP ENGINE • BUILT FROM SCRATCH</span>
    </div>

    <!-- Main Hero Split Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Headline, Narrative & CTAs (lg:col-span-7) -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <h1 class="hero-headline font-extrabold tracking-tight text-[var(--ink)] leading-[1.05] mb-6">
          A serious OLAP database engine. <span class="text-[var(--brand)]">Written in Python.</span>
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-[var(--muted)] leading-relaxed mb-8 prose-measure">
          Explore how a columnar database engine stores data on disk, cuts row scans with Roaring Bitmaps, and answers analytical queries with mechanical sympathy.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 mb-8">
          <a
            href="https://github.com/lokeshdevnani/mastidb"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-[var(--ink)] hover:bg-[var(--brand)] text-white text-sm font-semibold transition-all shadow-md hover:shadow-lg focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--brand)]"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>View on GitHub</span>
          </a>

          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl border border-[var(--line)] bg-[var(--surface-tint)] hover:bg-[var(--lavender)] text-[var(--ink)] text-sm font-semibold transition-all hover:border-[var(--brand)]/30 focus-visible:ring-2 focus-visible:ring-[var(--brand)]"
          >
            <span>How it works</span>
            <svg class="w-4 h-4 text-[var(--muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Compact Visual Path: SQL -> Dict -> Bitmap -> Result -->
        <div class="p-4 rounded-xl border border-[var(--line)] bg-[var(--surface-tint)]/60 max-w-xl">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--muted)] mb-3 font-semibold flex flex-wrap items-center justify-between gap-1">
            <span>Query Execution Pipeline</span>
            <span class="text-[var(--brand)]">No full-table scans</span>
          </div>

          <div class="grid grid-cols-4 gap-2 text-center text-xs">
            <div class="p-2 rounded-lg bg-[var(--surface)] border border-[var(--line)] flex flex-col items-center">
              <span class="text-xs font-bold text-[var(--brand)]">SQL</span>
              <span class="text-[10px] text-[var(--muted)] leading-tight mt-0.5">Parse & AST</span>
            </div>
            <div class="p-2 rounded-lg bg-[var(--dict-violet-bg)] border border-[var(--dict-violet-border)] flex flex-col items-center">
              <span class="text-xs font-bold text-[var(--dict-violet)]">Dict</span>
              <span class="text-[10px] text-[var(--dict-violet)]/80 leading-tight mt-0.5">Binary Search</span>
            </div>
            <div class="p-2 rounded-lg bg-[var(--bitmap-amber-bg)] border border-[var(--bitmap-amber-border)] flex flex-col items-center">
              <span class="text-xs font-bold text-[var(--bitmap-amber)]">Bitmap</span>
              <span class="text-[10px] text-[var(--bitmap-amber)]/80 leading-tight mt-0.5">Roaring Bitset</span>
            </div>
            <div class="p-2 rounded-lg bg-[var(--result-green-bg)] border border-[var(--result-green-border)] flex flex-col items-center">
              <span class="text-xs font-bold text-[var(--result-green)]">Result</span>
              <span class="text-[10px] text-[var(--result-green)]/80 leading-tight mt-0.5">Late Decode</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Mascot & Interactive Terminal (lg:col-span-5) -->
      <div class="lg:col-span-5 flex flex-col items-center gap-5 w-full">
        <!-- Mascot Presentation (Full body with legs preserved, never cropped, responsive) -->
        <div class="mascot-wrapper flex flex-col items-center justify-center relative">
          <div class="mascot-bubble absolute -top-3 right-2 sm:right-6 bg-white border border-[var(--line)] px-2.5 py-1 rounded-full text-xs font-bold text-[var(--brand)] shadow-sm pointer-events-none z-10 flex items-center gap-1">
            <span>Same data. More Masti!</span>
            <span class="text-amber-500">✨</span>
          </div>
          <!-- Preserves entire mascot body including legs at all viewport sizes -->
          <img
            src="/mastidb-mascot.webp"
            alt="MastiDB Mascot thinking, winking and pointing to the terminal"
            width="360"
            height="340"
            class="mascot-image max-w-[190px] sm:max-w-[240px] md:max-w-[270px] lg:max-w-[290px] h-auto object-contain select-none"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Terminal: Demonstrates real commands with copy controls -->
        <div class="w-full">
          <HeroTerminal client:load />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-headline {
    font-size: clamp(2.35rem, 6.5vw, 4.25rem);
  }

  @media (min-width: 1024px) {
    .hero-headline {
      font-size: clamp(3.25rem, 4.5vw, 4.75rem);
    }
  }

  /* Mascot styles: ensure whole figure is preserved without clipping or zoom */
  .mascot-image {
    aspect-ratio: 360 / 340;
    filter: drop-shadow(0 12px 24px rgba(20, 32, 58, 0.08));
    transition: transform 0.2s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot-image {
      animation: none !important;
    }
  }
</style>
