---
---

<header class="sticky top-0 z-50 w-full border-b border-[var(--line)] bg-[var(--surface)]/90 backdrop-blur-md transition-colors">
  <div class="site-container flex items-center justify-between h-16">
    <!-- Brand / Wordmark with Masti in ink and DB in purple -->
    <a href="#" class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand)] rounded-md">
      <div class="w-8 h-8 rounded-xl bg-[var(--lavender)] border border-[var(--brand)]/20 flex items-center justify-center p-0.5 overflow-hidden transition-transform group-hover:scale-105 shadow-xs">
        <img src="/mastidb-logo.png" alt="MastiDB Wink Mascot Logo" class="w-full h-full object-contain" />
      </div>
      <div class="flex items-baseline">
        <span class="font-extrabold text-2xl tracking-tight text-[var(--ink)]">Masti</span><span class="font-extrabold text-2xl tracking-tight text-[var(--brand)]">DB</span>
      </div>
    </a>

    <!-- Desktop Navigation Links matching mock -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-[var(--muted)]" aria-label="Main Navigation">
      <a href="#" class="text-[var(--ink)] relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-[var(--brand)] after:rounded-full">Home</a>
      <a href="#how-it-works" class="hover:text-[var(--ink)] transition-colors py-1">How it works</a>
      <a href="#query-trace" class="hover:text-[var(--ink)] transition-colors py-1">Follow a query</a>
      <a href="#segment" class="hover:text-[var(--ink)] transition-colors py-1">File format</a>
      <a href="#techniques" class="hover:text-[var(--ink)] transition-colors py-1">Techniques</a>
      <a href="#status" class="hover:text-[var(--ink)] transition-colors py-1">Status</a>
    </nav>

    <!-- Desktop Action Buttons matching mock -->
    <div class="hidden sm:flex items-center gap-4">
      <!-- GitHub Link -->
      <a
        href="https://github.com/lokeshdevnani/mastidb"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--ink)] hover:text-[var(--brand)] transition-colors py-1.5"
      >
        <svg class="w-4 h-4 fill-current text-[var(--ink)]" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>

      <!-- Quick pip install copy button (dark rounded pill matching mock) -->
      <button
        id="nav-copy-pip"
        type="button"
        title="Copy pip install command"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-[var(--ink)] hover:bg-[var(--brand)] text-white text-xs font-mono font-medium transition-all shadow-xs cursor-pointer"
      >
        <span class="text-[var(--brand-blue)] select-none">&gt;_</span>
        <span>pip install mastidb</span>
        <svg id="nav-copy-icon" class="w-3.5 h-3.5 text-slate-300 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg id="nav-check-icon" class="w-3.5 h-3.5 text-emerald-400 ml-0.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="p-2 rounded-lg border border-[var(--line)] text-[var(--ink)] hover:bg-[var(--surface-tint)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand)]"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-[var(--line)] bg-[var(--surface)] px-6 py-5 transition-all"
  >
    <nav class="flex flex-col gap-4 text-base font-medium text-[var(--muted)]" aria-label="Mobile Navigation">
      <a href="#how-it-works" class="hover:text-[var(--ink)] transition-colors py-1.5 mobile-link">How it works</a>
      <a href="#query-trace" class="hover:text-[var(--ink)] transition-colors py-1.5 mobile-link">Follow a query</a>
      <a href="#segment" class="hover:text-[var(--ink)] transition-colors py-1.5 mobile-link">File format</a>
      <a href="#techniques" class="hover:text-[var(--ink)] transition-colors py-1.5 mobile-link">Techniques</a>
      <a href="#status" class="hover:text-[var(--ink)] transition-colors py-1.5 mobile-link">Status</a>
      
      <div class="pt-4 border-t border-[var(--line)] flex flex-col gap-3">
        <button
          id="mobile-copy-pip"
          type="button"
          class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg border border-[var(--line)] bg-[var(--surface-tint)] font-mono text-xs text-[var(--ink)]"
        >
          <span class="text-[var(--brand)]">$</span>
          <span>pip install mastidb</span>
        </button>
        <a
          href="https://github.com/lokeshdevnani/mastidb"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg bg-[var(--ink)] text-white text-sm font-medium"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>View on GitHub</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function setMenuOpen(open: boolean) {
    if (!menu || !toggleBtn) return;
    toggleBtn.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.classList.remove('hidden');
      hamburger?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      menu.classList.add('hidden');
      hamburger?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isExpanded);
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  // Copy pip install helper
  function setupCopy(btnId: string, iconId?: string, checkId?: string) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('pip install mastidb');
        const icon = iconId ? document.getElementById(iconId) : null;
        const check = checkId ? document.getElementById(checkId) : null;
        if (icon && check) {
          icon.classList.add('hidden');
          check.classList.remove('hidden');
          setTimeout(() => {
            icon.classList.remove('hidden');
            check.classList.add('hidden');
          }, 2000);
        }
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });
  }

  setupCopy('nav-copy-pip', 'nav-copy-icon', 'nav-check-icon');
  setupCopy('mobile-copy-pip');
</script>
