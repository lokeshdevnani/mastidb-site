---
---

<section id="how-it-works" class="section-spacing border-b border-[var(--line)] bg-[var(--surface-tint)]">
  <div class="site-container">
    
    <!-- Outer Soft Tinted Container matching mock.png -->
    <div class="p-8 sm:p-12 lg:p-14 rounded-3xl bg-[var(--surface)] border border-[var(--line)] shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Column: Story Headline, Narrative & Read Full Story CTA (lg:col-span-4) -->
        <div class="lg:col-span-4 flex flex-col justify-center">
          <div class="text-xs font-mono font-bold tracking-widest uppercase text-[var(--brand)] mb-3">
            HOW IT STARTED
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-extrabold text-[var(--ink)] tracking-tight leading-[1.1] mb-4">
            My journey to<br class="hidden lg:inline" /> MastiDB
          </h2>
          <p class="text-sm sm:text-base text-[var(--muted)] leading-relaxed mb-6">
            MastiDB started as a learning project — a way for me to truly understand how modern analytical databases work. Along the way it turned into a real, working engine.
          </p>

          <!-- Read full story button matching mock -->
          <div>
            <a
              href="https://github.com/lokeshdevnani/mastidb/blob/main/ARCHITECTURE.md"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-[var(--line)] bg-[var(--surface-tint)] hover:bg-[var(--lavender)] text-xs font-bold text-[var(--ink)] hover:text-[var(--brand)] hover:border-[var(--brand)]/30 transition-all shadow-xs"
            >
              <span>Read the full story</span>
              <svg class="w-3.5 h-3.5 text-[var(--brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Column: Single White Card with 3-Step Process Flow (lg:col-span-8) -->
        <div class="lg:col-span-8">
          <div class="p-6 sm:p-8 rounded-2xl bg-[var(--surface-tint)] border border-[var(--line)] shadow-xs">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 relative">
              
              <!-- Step 1: Druid -->
              <div class="flex flex-col justify-between relative">
                <div>
                  <!-- Number badge and arrow on desktop -->
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-7 h-7 rounded-full bg-[var(--brand)] text-white font-mono font-bold text-xs flex items-center justify-center shadow-xs">
                      1
                    </div>
                    <!-- Connecting arrow pointing right to step 2 (visible on md+) -->
                    <div class="hidden md:block text-[var(--brand)]/40 text-base select-none font-bold pr-2">
                      →
                    </div>
                  </div>

                  <h3 class="text-base font-bold text-[var(--ink)] mb-2">
                    Druid
                  </h3>
                  <p class="text-xs text-[var(--muted)] leading-relaxed">
                    I first worked with Druid and was fascinated by how it could query huge datasets so quickly.
                  </p>
                </div>

                <!-- 3D Database Cylinder Graphic matching mock -->
                <div class="flex items-center justify-center pt-6 pb-1">
                  <img
                    src="/icon-cylinder-3d.png"
                    alt="Apache Druid Database Cylinder"
                    class="w-10 h-10 object-contain transition-transform hover:scale-110"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Step 2: Database Systems -->
              <div class="flex flex-col justify-between relative">
                <div>
                  <!-- Number badge and arrow on desktop -->
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-7 h-7 rounded-full bg-[var(--brand)] text-white font-mono font-bold text-xs flex items-center justify-center shadow-xs">
                      2
                    </div>
                    <!-- Connecting arrow pointing right to step 3 (visible on md+) -->
                    <div class="hidden md:block text-[var(--brand)]/40 text-base select-none font-bold pr-2">
                      →
                    </div>
                  </div>

                  <h3 class="text-base font-bold text-[var(--ink)] mb-2">
                    Database courses
                  </h3>
                  <p class="text-xs text-[var(--muted)] leading-relaxed">
                    So I went deeper — database courses, papers, and open source systems.
                  </p>
                </div>

                <!-- 3D Open Book Graphic matching mock -->
                <div class="flex items-center justify-center pt-6 pb-1">
                  <img
                    src="/icon-book-3d.png"
                    alt="Database Papers and Books"
                    class="w-10 h-10 object-contain transition-transform hover:scale-110"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Step 3: Building MastiDB -->
              <div class="flex flex-col justify-between relative">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-7 h-7 rounded-full bg-[var(--brand)] text-white font-mono font-bold text-xs flex items-center justify-center shadow-xs">
                      3
                    </div>
                  </div>

                  <h3 class="text-base font-bold text-[var(--ink)] mb-2">
                    Building MastiDB
                  </h3>
                  <p class="text-xs text-[var(--muted)] leading-relaxed">
                    So I built MastiDB — a small, from-scratch OLAP engine in Python to make these ideas concrete.
                  </p>
                </div>

                <!-- Mascot Logo Avatar Graphic matching mock -->
                <div class="flex items-center justify-center pt-5 pb-0">
                  <img
                    src="/icon-mascot-3d.png"
                    alt="MastiDB Mascot"
                    class="w-14 h-11 object-contain transition-transform hover:scale-110"
                    loading="lazy"
                  />
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
