---
interface Technique {
  number: string;
  title: string;
  problem: string;
  solution: string;
  tradeoff: string;
  docAnchor: string;
}

const techniques: Technique[] = [
  {
    number: "01",
    title: "Columnar Segments & Fixed Addressing",
    problem: "Row storage reads every column off disk, even the ones the query never asks for.",
    solution: "Each column lives in its own immutable file, and every row ID is a fixed 4-byte integer, so row i is found by arithmetic (offset + i * 4) rather than by walking an index.",
    tradeoff: "Costs 4 bytes per row even for columns with only a handful of distinct values, and it is a poor fit for single-row OLTP work.",
    docAnchor: "2-storage-architecture"
  },
  {
    number: "02",
    title: "Sorted Dictionary Encoding",
    problem: "Storing the same strings again on every row wastes space, and comparing them in Python is slow.",
    solution: "Each distinct string is stored once in a sorted dictionary. Queries find a value by binary search in O(log N), and ORDER BY on a string column sorts integers instead of strings.",
    tradeoff: "Columns with many distinct values make the dictionary large, and numbers are still stored as strings today, so SUM and AVG parse a float per row.",
    docAnchor: "24-the-payload-file-five-sections-back-to-back"
  },
  {
    number: "03",
    title: "Roaring Bitmap Indexing",
    problem: "Checking a WHERE clause row by row means reading every row in the table.",
    solution: "Ingestion builds a compressed Roaring Bitmap for every distinct value. An equality filter is then one bitmap lookup, and AND and OR are bitwise intersection and union.",
    tradeoff: "The bitmaps add roughly 15-40% to segment size, and filtering is equality-only today - ranges and inequalities are not indexed yet.",
    docAnchor: "42-filtering-where-becomes-one-bitmap"
  },
  {
    number: "04",
    title: "Late Materialization",
    problem: "Turning IDs back into strings for rows that never reach the output is work thrown away.",
    solution: "Columns stay as integer IDs through filtering, grouping, and sorting. Only the rows that survive LIMIT, or the distinct output groups, are decoded back into strings.",
    tradeoff: "A non-aggregate query with a large LIMIT ends up doing many random seeks into the dictionary files to materialize its columns.",
    docAnchor: "44-the-value-matrix-the-one-place-data-is-materialized"
  },
  {
    number: "05",
    title: "Mergeable Partial Aggregation",
    problem: "Every segment has its own dictionary, so partial results from two segments cannot simply be concatenated.",
    solution: "Each segment returns an AggregatePartial whose merge() is associative and commutative - AVG, for instance, carries (sum, count) until the very end - so partials from any number of segments combine safely.",
    tradeoff: "Group keys have to be decoded to strings before they cross a segment boundary, since two segments map the same string to different IDs.",
    docAnchor: "5-aggregate-queries-in-detail"
  },
  {
    number: "06",
    title: "MyPyC Ahead-of-Time Compilation",
    problem: "Interpreter overhead and dynamic dispatch dominate the cost of a tight inner loop in Python.",
    solution: "The hot inner loops are type-annotated and compiled to native C extensions with MyPyC, which cut runtime by about 60% without changing a single algorithm.",
    tradeoff: "Needs a C compiler at install time (it falls back to pure Python without one) and holds the compiled modules to strict static types.",
    docAnchor: "8-where-the-time-actually-goes"
  }
];
---

<section id="techniques" class="section-spacing border-b border-[var(--line)] bg-[var(--surface)]">
  <div class="site-container">
    
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="text-xs font-mono font-bold tracking-widest uppercase text-[var(--brand)] mb-3">
        DESIGN TRADE-OFFS
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[var(--ink)] tracking-tight mb-4">
        Core engine techniques & trade-offs
      </h2>
      <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed prose-measure">
        Every design choice here trades speed against space against complexity. For each one: the problem it solves, what MastiDB does about it, and what that costs.
      </p>
    </div>

    <!-- Scannable Cards Grid (3x2 on desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {techniques.map((t) => (
        <div class="p-6 sm:p-7 rounded-2xl bg-[var(--surface)] border border-[var(--line)] shadow-sm hover:border-[var(--brand)]/30 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <!-- Card Number & Title -->
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-[var(--surface-tint)] text-[var(--muted)] border border-[var(--line)]">
                {t.number}
              </span>
              <a
                href={`https://github.com/lokeshdevnani/mastidb/blob/main/ARCHITECTURE.md#${t.docAnchor}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono text-[var(--brand)] hover:underline flex items-center gap-1"
              >
                <span>Docs</span>
                <span>↗</span>
              </a>
            </div>

            <h3 class="text-lg font-bold text-[var(--ink)] mb-4 leading-snug">
              {t.title}
            </h3>

            <!-- What problem arises -->
            <div class="mb-3.5">
              <div class="text-[10px] font-mono uppercase tracking-wider font-bold text-[var(--muted)] mb-1">
                The Problem
              </div>
              <p class="text-xs text-[var(--ink)] leading-relaxed">
                {t.problem}
              </p>
            </div>

            <!-- What MastiDB does -->
            <div class="mb-3.5">
              <div class="text-[10px] font-mono uppercase tracking-wider font-bold text-[var(--brand)] mb-1">
                What MastiDB Does
              </div>
              <p class="text-xs text-[var(--ink)] leading-relaxed">
                {t.solution}
              </p>
            </div>
          </div>

          <!-- What it costs or limits -->
          <div class="mt-4 border-t border-[var(--line)] bg-[var(--surface-tint)] -mx-6 -mb-6 sm:-mx-7 sm:-mb-7 px-6 sm:px-7 py-4 rounded-b-2xl">
            <div class="text-[10px] font-mono uppercase tracking-wider font-bold text-[var(--encoded-coral)] mb-1">
              The Cost / Limitation
            </div>
            <p class="text-xs text-[var(--muted)] leading-relaxed">
              {t.tradeoff}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
