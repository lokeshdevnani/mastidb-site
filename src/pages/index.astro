---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import { QueryWalkthrough } from '../components/QueryWalkthrough';
import SegmentInspector from '../components/SegmentInspector.astro';
import Techniques from '../components/Techniques.astro';
import Status from '../components/Status.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="MastiDB - A serious OLAP database engine. Written in Python."
  description="See how MastiDB stores data in columnar segments, uses Roaring Bitmaps to skip rows it does not need, and keeps values encoded as integers until the last step."
>
  <Navbar />
  <main id="main-content" class="flex-1">
    <Hero />
    <Story />
    <QueryWalkthrough client:visible />
    <SegmentInspector />
    <Techniques />
    <Status />
  </main>
  <Footer />
</Layout>
